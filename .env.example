# Local dev via ngrok (recommended for Expo Go + Google OAuth)
# 1. ngrok config add-authtoken <token>   (one-time, from https://dashboard.ngrok.com/get-started/your-authtoken)
# 2. ngrok http 54321
# 3. Paste the https://....ngrok-free.dev URL in BOTH places below (no trailing slash):
#    - app/.env.local  → EXPO_PUBLIC_SUPABASE_URL
#    - repo-root .env  → SUPABASE_EXTERNAL_URL  (required so OAuth callbacks use ngrok, not 127.0.0.1)
# 4. supabase stop && supabase start
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_SUBDOMAIN.ngrok-free.dev
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Google OAuth — also set in repo-root .env for local Supabase CLI
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
 